# Get this from https://www.assemblyai.com/dashboard/signup
# Used for Sync STT (always). Also used for the agent when AGENT_LLM_PROVIDER=assemblyai.
ASSEMBLYAI_API_KEY=

# Agent LLM: assemblyai (default) or ifm (K2 Horizon on api.ifm.ai — see https://docs.ifm.ai/)
AGENT_LLM_PROVIDER=assemblyai

# IFM / K2 Horizon (when AGENT_LLM_PROVIDER=ifm). Key from IFM console / api.ifm.ai.
IFM_API_TOKEN=
# IFM_API_KEY=   # alias for IFM_API_TOKEN
# IFM_MODEL=IFM/K2-Horizon-375B-A23B
# IFM_REASONING_EFFORT=high
# IFM_TEMPERATURE=0.3
# IFM_BASE_URL=https://api.ifm.ai/v1

# GitHub OAuth app: https://github.com/settings/applications/new
# Homepage URL: http://127.0.0.1:5000
# Authorization callback URL: http://127.0.0.1:5000/api/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GITHUB_OAUTH_CALLBACK=http://127.0.0.1:5000/api/github/callback

# Optional. A token already in the environment is used when nobody has signed in.
# OAuth replaces this for the browser session.
GITHUB_TOKEN=

# The repo Friday opens on startup, as "owner/name". Leave blank to choose one in the UI.
GITHUB_REPO=

# Optional Supabase project named friday. The map does not wait on this.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# TypeSafe Jev (server-side only). https://console.typesafe.ai/keys
TYPESAFE_API_KEY=

# Gemini runs on Vertex AI through the gcloud CLI. No Gemini API key.
VERTEX_PROJECT=project-f0b6b4ce-541f-43ff-9f7
VERTEX_LOCATION=us-central1
# VERTEX_MODEL=gemini-2.5-flash
